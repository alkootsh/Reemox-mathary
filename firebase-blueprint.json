{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Tenant company entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Company branch entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Membership": {
      "title": "Membership",
      "description": "User company membership & role mapping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "companyId": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "userId", "companyId", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" }
      },
      "required": ["id", "companyId", "name", "sku", "price", "quantity"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "companyId", "name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "openingBalance": { "type": "number" }
      },
      "required": ["id", "companyId", "name", "phone", "openingBalance"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sale transaction entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "customer": { "type": "string" },
        "total": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "companyId", "total", "date"]
    }
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "All tenant companies"
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "Company branches"
    },
    "/memberships/{membershipId}": {
      "schema": "Membership",
      "description": "Company user memberships"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "All products in inventory"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "All product categories"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "All customers"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "All sales transactions"
    }
  }
}
