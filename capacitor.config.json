{
  "appId": "com.maro.pos.accounting",
  "appName": "MARO Lite POS",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0F172A",
      "showSpinner": true,
      "spinnerColor": "#F59E0B"
    },
    "Camera": {
      "permissions": ["camera"]
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false
  }
}
